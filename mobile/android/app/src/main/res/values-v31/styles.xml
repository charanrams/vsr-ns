<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ system splash: cream background, no icon, so launch blends into the Flutter splash video. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/vsr_cream</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon_none</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/vsr_cream</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/vsr_cream</item>
    </style>
</resources>
