NODE_ENV=development
PORT=5050
# Leave MONGO_URI empty in development to use an in-memory MongoDB (auto-seeded)
MONGO_URI=mongodb://127.0.0.1:27017/vsr
# Websites allowed to call this API from a browser (comma separated; wildcards like https://*.vsr.in work).
# In development any http://localhost:<port> is also allowed. The mobile app needs no entry.
# Production example: CORS_ORIGINS=https://vsr.in,https://www.vsr.in,https://admin.vsr.in
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
# SMTP (Nodemailer). If empty in development, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="VSR <no-reply@vsr.in>"
# Razorpay. If empty, only Cash on Delivery is offered.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Cloudinary. If empty, image uploads are disabled (image URLs can still be pasted).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SEED_ADMIN_PASSWORD=Admin@123

# Mobile app gates
APP_MIN_VERSION=1.0.0
APP_LATEST_VERSION=1.0.0
APP_UNSUPPORTED_BELOW=0.0.0
MAINTENANCE_MODE=false
# Serviceable PIN code prefixes (comma separated). 5000 = Hyderabad 5000xx
SERVICE_PINCODES=5000

# Push notifications (Firebase Cloud Messaging).
# Local: download the service-account key (Firebase console > Project settings > Service accounts)
# to backend/firebase-service-account.json (gitignored) and point to it. Hosting: paste the JSON or its base64 into _JSON.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# Browser push (Firebase web app). Served to the website via GET /store/config.
# VAPID key: Firebase console > Project settings > Cloud Messaging > Web Push certificates > Generate key pair.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_APP_ID=
FIREBASE_AUTH_DOMAIN=vsr-ns.firebaseapp.com
FIREBASE_PROJECT_ID=vsr-ns
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=
